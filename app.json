{
  "expo": {
    "name": "evaira",
    "slug": "evaira",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/circle_logo.png",
    "scheme": "evaira",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.evaira"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/circle_logo.png"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
